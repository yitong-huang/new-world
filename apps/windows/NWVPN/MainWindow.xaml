<Window x:Class="NWVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NWVPN"
        Width="420"
        Height="420"
        MinWidth="380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel>
            <Label Content="服务器" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Label Content="主机" Foreground="Gray" FontSize="11" Margin="0,-4,0,0"/>
            <TextBox x:Name="HostBox" Height="26" Margin="0,2,0,8"/>
            <Label Content="端口" Foreground="Gray" FontSize="11"/>
            <TextBox x:Name="PortBox" Height="26" Width="120" HorizontalAlignment="Left" Margin="0,2,0,8"/>

            <Label Content="认证（可选）" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <Label Content="用户名" Foreground="Gray" FontSize="11"/>
            <TextBox x:Name="UserBox" Height="26" Margin="0,2,0,8"/>
            <Label Content="密码" Foreground="Gray" FontSize="11"/>
            <PasswordBox x:Name="PassBox" Height="26" Margin="0,2,0,8"/>

            <CheckBox x:Name="InsecureCheck" Content="跳过 TLS 证书校验（开发 / 自签服务）" Margin="0,8,0,4"/>
            <StackPanel x:Name="CaPanel" Orientation="Vertical" Margin="0,0,0,8">
                <Label Content="CA / 服务端证书 PEM（启用校验时使用）" Foreground="Gray" FontSize="11"/>
                <TextBox x:Name="CaPathBox" Height="26" Margin="0,2,0,0"/>
            </StackPanel>

            <Label Content="状态" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <TextBlock x:Name="StatusText" Text="未连接" Foreground="Gray" TextWrapping="Wrap"/>
            <TextBlock x:Name="ErrorText" Foreground="DarkRed" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>

            <TextBlock Text="日志（nw-client）" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <Border BorderBrush="LightGray" BorderThickness="1" Height="100" Background="#f8f8f8">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Padding="6"/>
                </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="ConnectBtn" Content="连接" Width="100" Height="32" Margin="0,0,8,0" Click="Connect_Click"/>
                <Button x:Name="DisconnectBtn" Content="断开" Width="100" Height="32" IsEnabled="False" Click="Disconnect_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
